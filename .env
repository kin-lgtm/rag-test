# OpenAI API Key (get from https://platform.openai.com/)
OPENAI_API_KEY=sk-your-api-key-here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Settings
EMBEDDING_MODEL=text-embedding-ada-002
CHAT_MODEL=gpt-3.5-turbo
TEMPERATURE=0.7

# Vector Database
VECTORSTORE_PATH=./chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200